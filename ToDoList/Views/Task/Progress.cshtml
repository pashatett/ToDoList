@model IEnumerable<ToDoList.Domain.ViewModels.Task.CreateTaskViewModel>

@{
    ViewData["Title"] = "Progress";
}

<h2>Progress</h2>

<table class="table">
    <thead>
        <tr>
            <th>Название</th>
            <th>Описание</th>
            <th>Статус</th>
            <th>Дата создания</th>
            <th>Приоритет</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var task in Model)
            {
                <tr>
                    <td>@task.Name</td>
                    <td>@task.Description</td>
                    <td>@(task.IsDone ? "Completed" : "In Progress")</td>
                    <td>@task.Created.ToString("dd.MM.yyyy")</td>
                    <td>@task.Priority</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="5" class="text-center">No tasks found.</td>
            </tr>
        }
    </tbody>
</table>
